{
  "name": "pft-interpreter",
  "productName": "PulmCrit Daddy",
  "version": "8.2.0",
  "description": "PulmCrit Daddy: PFT interpretation (ERS/ATS 2022, z-score / LLN), a Learn section (anatomy, physiology, bronchoscopy, ventilation, ECMO, haemodynamics, ECG, nodules) with interactive labs and scenarios, and a local case bank. Formerly PFT Interpreter.",
  "author": "PulmCrit Daddy",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/main.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.pftinterpreter.desktop",
    "productName": "PulmCrit Daddy",
    "copyright": "PulmCrit Daddy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PulmCrit-Daddy-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PulmCrit Daddy ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PulmCrit-Daddy-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PulmCrit-Daddy-Portable-${version}-win-${arch}.${ext}"
    }
  }
}
