{
  "name": "pft-interpreter",
  "productName": "PFT Interpreter",
  "version": "3.2.0",
  "description": "Pulmonary function test interpretation (ERS/ATS 2022, z-score / LLN) with Learn pages, 6MWD trend and a local case bank.",
  "author": "PFT Interpreter",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/main.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.pftinterpreter.desktop",
    "productName": "PFT Interpreter",
    "copyright": "PFT Interpreter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PFT-Interpreter-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PFT Interpreter ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PFT-Interpreter-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PFT-Interpreter-Portable-${version}-win-${arch}.${ext}"
    }
  }
}
